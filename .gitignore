# ══════════════════════════════════════════════════════════
#  .gitignore —— 脉塔电机选型系统
#  这个仓库是公开的，以下内容不提交
# ══════════════════════════════════════════════════════════

# ── 备份文件（本地回滚用，体积大且含旧密钥）──
_backup/
*.bak
*.bak_*
*.bak2_*

# ── 内部资料（不上传到公开仓库）──
客户版/
参考素材/
assembly-app/
项目开发计划书.md

# ── Cloudflare Pages 构建产物 ──
dist/

# ── 编辑器 / IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── 系统文件 ──
Thumbs.db
desktop.ini
.DS_Store

# ── 临时与日志 ──
*.tmp
*.log
*.pid
sync_log.txt
推送日志.txt
.git_sync_lock

# ── 本地环境配置（如有）──
.env
.env.*
secrets.json
config.local.js
